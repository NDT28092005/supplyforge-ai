# Application and MySQL Configuration
APP_ENV=development
DJANGO_SECRET_KEY=<generate-a-unique-secret-at-least-50-characters>
DJANGO_DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
MYSQL_DATABASE=supplyforge
MYSQL_USER=supplyforge
MYSQL_PASSWORD=<required-database-password>
MYSQL_ROOT_PASSWORD=<required-database-root-password>
MYSQL_PORT=3306
DB_CONN_MAX_AGE=600
DB_REPLICA_ENABLED=false
DB_REPLICA_HOST=
DB_REPLICA_DATABASE=
DB_REPLICA_USER=
DB_REPLICA_PASSWORD=
DB_REPLICA_PORT=3306

# Frontend (browser calls API)
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WORKSPACE_ID=1
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_PROXY_IPS=
RATE_LIMIT_ENABLED=false
RATE_LIMIT_FAIL_CLOSED=false
RATE_LIMIT_API_REQUESTS=120
RATE_LIMIT_AUTH_REQUESTS=20
RATE_LIMIT_UPLOAD_REQUESTS=10

# Local development uses filesystem storage. Production must use S3/MinIO.
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=

# Gemini (mapping columns — headers + small sample)
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Google OAuth (disabled until explicitly configured)
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

ODOO_ENABLED=false
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_PASSWORD=
