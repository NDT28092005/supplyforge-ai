# Source control and local IDE files
.git
.gitignore
.idea/
*.iml

# Local Python environments and generated bytecode
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local configuration and development secrets. ECS receives these from
# Secrets Manager and task environment variables instead.
.env
.env.*
!.env.example

# Runtime/test artefacts that must not become part of the deployable image.
uploads/
tmp/
data/
reports/
*.sqlite3
*.db
*.log
media/
staticfiles/

# Unrelated build output and documentation
target/
node_modules/
HELP.md
