# Environment Mode: development | staging | production
APP_ENV=development

# Django Settings
DJANGO_SECRET_KEY=django-insecure-supplyforge-ai-example-secret-key
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (MySQL default, SQLite fallback if USE_SQLITE=1 or MySQL unavailable)
USE_SQLITE=1
MYSQL_DATABASE=supplyforge
MYSQL_USER=supplyforge
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Frontend & CORS Settings
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WORKSPACE_ID=1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://127.0.0.1:3000

# Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Integrations (Odoo ERP, Shopee)
ODOO_URL=http://localhost:8069
ODOO_DB=supplyforge_odoo
ODOO_USERNAME=admin
ODOO_PASSWORD=admin
SHOPEE_PARTNER_ID=0
SHOPEE_PARTNER_KEY=
SHOPEE_API_HOST=https://partner.shopeemobile.com
SHOPEE_REDIRECT_URL=http://localhost:8080/api/v1/shopee/oauth/callback

# Email Delivery Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SupplyForge AI <noreply@supplyforge.local>

# Celery & Redis Cache
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Monitoring & Error Tracking
SENTRY_DSN=
