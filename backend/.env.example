# Environment Mode: development | staging | production
APP_ENV=development

# Django Settings
DJANGO_SECRET_KEY=<generate-a-unique-secret-at-least-50-characters>
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (SQLite is development/test-only; production must use MySQL)
USE_SQLITE=1
SQLITE_PATH=./db.sqlite3
MYSQL_DATABASE=supplyforge
MYSQL_USER=supplyforge
MYSQL_PASSWORD=<required-database-password>
MYSQL_ROOT_PASSWORD=<required-database-root-password>
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
DB_CONN_MAX_AGE=600
DB_REPLICA_ENABLED=false
DB_REPLICA_HOST=
DB_REPLICA_DATABASE=
DB_REPLICA_USER=
DB_REPLICA_PASSWORD=
DB_REPLICA_PORT=3306

# Frontend & CORS Settings
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WORKSPACE_ID=1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://127.0.0.1:3000
TRUSTED_PROXY_IPS=
RATE_LIMIT_ENABLED=false
RATE_LIMIT_FAIL_CLOSED=false
RATE_LIMIT_API_REQUESTS=120
RATE_LIMIT_AUTH_REQUESTS=20
RATE_LIMIT_UPLOAD_REQUESTS=10

# Local development uses filesystem storage. Production uses S3 with ECS task roles.
STORAGE_BACKEND=local
# auto: SDK chain when keys are blank (ECS task role/SSO); static: MinIO or explicit key pair.
S3_AUTH_MODE=auto
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_LAKE_BUCKET=
S3_REGION=
S3_MULTIPART_PART_SIZE_BYTES=8388608
S3_PRESIGNED_UPLOAD_TTL_SECONDS=900
SQS_INGESTION_QUEUE_URL=
INGESTION_CHUNK_ROW_SIZE=20000
INGESTION_MAX_REPORTED_ERRORS=1000
INGESTION_ARCHIVE_SNAPSHOT_ROW_LIMIT=1000
INGESTION_MAX_ROWS=10000000

# Gemini AI API Configuration
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Google OAuth (disabled until explicitly configured)
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Integrations (Odoo ERP, Shopee)
ODOO_ENABLED=false
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_PASSWORD=
SHOPEE_PARTNER_ID=0
SHOPEE_PARTNER_KEY=
SHOPEE_API_HOST=https://partner.shopeemobile.com
SHOPEE_REDIRECT_URL=http://localhost:8080/api/v1/shopee/oauth/callback

# Email Delivery Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SupplyForge AI <noreply@supplyforge.local>

# Celery & Redis Cache
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Monitoring & Error Tracking
SENTRY_DSN=
