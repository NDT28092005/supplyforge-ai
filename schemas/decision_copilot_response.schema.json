{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DecisionCopilotResponsePayload",
  "type": "object",
  "required": ["status", "query_type", "decision_state", "decision_context", "dataset_version"],
  "properties": {
    "status": { "type": "string", "enum": ["SUCCESS", "NO_DATA", "ERROR"] },
    "query_type": {
      "type": "string",
      "enum": ["RECOMMENDATION", "WHY_RECOMMENDATION", "COMPARE_OPTIONS", "SCENARIO", "RECOVERY", "TRADE_OFF", "PRIORITY", "ALTERNATIVE"]
    },
    "decision_state": {
      "type": "string",
      "enum": ["RECOMMENDED", "SIMULATED", "SELECTED", "CONFIRMED", "EXECUTED"]
    },
    "decision_context": {
      "type": "object",
      "required": ["subject_id", "current_recommendation"],
      "properties": {
        "subject_id": { "type": "string" },
        "current_recommendation": { "type": "object" },
        "alternatives": { "type": "array" },
        "scenario": { "type": ["object", "null"] },
        "comparison": { "type": ["object", "null"] }
      }
    },
    "dataset_version": { "type": "string" }
  }
}
