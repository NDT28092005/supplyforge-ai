{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ActiveConversationContextContract",
  "type": "object",
  "required": ["conversation_id", "active_entities", "active_decision_id", "active_plan_id"],
  "properties": {
    "conversation_id": { "type": "string" },
    "current_topic": { "type": ["string", "null"] },
    "active_entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "id"],
        "properties": {
          "type": { "type": "string" },
          "id": { "type": "string" }
        }
      }
    },
    "active_decision_id": { "type": ["string", "null"] },
    "active_plan_id": { "type": ["string", "null"] },
    "user_preferences": { "type": "object" }
  }
}
