{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CapitalExposureSummaryPayload",
  "type": "object",
  "required": [
    "summary",
    "risk_distribution",
    "aging_distribution",
    "risk_aging_matrix",
    "priority_distribution",
    "top_exposure_skus",
    "exposure_concentration"
  ],
  "properties": {
    "summary": {
      "type": "object",
      "required": ["sku_count", "total_inventory_value", "total_risk_weighted_exposure"],
      "properties": {
        "sku_count": { "type": "integer" },
        "total_inventory_value": { "type": "number" },
        "total_risk_weighted_exposure": { "type": "number" },
        "total_probability_adjusted_exposure": { "type": "number" }
      }
    },
    "risk_distribution": { "type": "array" },
    "aging_distribution": { "type": "array" },
    "risk_aging_matrix": { "type": "array" },
    "priority_distribution": { "type": "array" },
    "top_exposure_skus": { "type": "array" },
    "exposure_concentration": {
      "type": "object",
      "required": ["top_10_exposure", "top_10_exposure_share"],
      "properties": {
        "top_10_exposure": { "type": "number" },
        "top_10_exposure_share": { "type": "number" }
      }
    }
  }
}
