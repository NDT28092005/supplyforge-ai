{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CopilotRequestPayload",
  "type": "object",
  "required": ["query", "session_id", "merchant_id"],
  "properties": {
    "query": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string" },
    "merchant_id": { "type": "string" },
    "sku_id": { "type": ["string", "null"] },
    "dataset_version": { "type": "string", "default": "v1.0" },
    "ui_context": {
      "type": "object",
      "properties": {
        "active_stage": { "type": "string" },
        "active_filters": { "type": "object" }
      }
    }
  }
}
