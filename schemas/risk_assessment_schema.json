{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UnifiedRiskAssessmentProfile",
  "type": "object",
  "properties": {
    "sku": { "type": "string" },
    "canonical_sku_id": { "type": "string" },
    "product_name": { "type": "string" },
    "assessment": {
      "type": "object",
      "properties": {
        "risk_class": { "type": "string", "enum": ["CRITICAL", "HIGH_RISK", "MEDIUM_RISK", "LOW_RISK"] },
        "risk_probability": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "risk_score": { "type": "number", "minimum": 0.0, "maximum": 100.0 }
      },
      "required": ["risk_class", "risk_probability", "risk_score"]
    },
    "diagnostics": {
      "type": "array",
      "items": { "type": "string" }
    },
    "primary_signals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "supporting_signals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence": { "type": "object" },
    "metadata": {
      "type": "object",
      "properties": {
        "decision_cutoff": { "type": "string" },
        "model_version": { "type": "string" },
        "calibration_version": { "type": "string" },
        "diagnostic_rule_version": { "type": "string" },
        "data_version": { "type": "string" }
      },
      "required": ["model_version", "calibration_version", "diagnostic_rule_version", "data_version"]
    },
    "assessment_status": { "type": "string", "enum": ["COMPLETE", "PARTIAL", "INVALID"] }
  },
  "required": ["sku", "assessment", "diagnostics", "evidence", "metadata", "assessment_status"]
}
