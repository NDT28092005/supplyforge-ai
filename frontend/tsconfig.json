    "noImplicitAny": false,
    "sourceMap": true,
    "removeComments": false,
    "strict": false,
    "typeRoots": [
      "./node_modules/@types"
    ]
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
