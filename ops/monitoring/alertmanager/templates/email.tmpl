{{ define "email.default.subject" }}
[SupplyForge][{{ if .CommonLabels.severity }}{{ .CommonLabels.severity }}{{ else }}P3{{ end }}][{{ .Status | toUpper }}] {{ .CommonLabels.alertname }} ({{ if .CommonLabels.service }}{{ .CommonLabels.service }}{{ else }}system{{ end }})
{{ end }}

{{ define "email.default.html" }}
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    body { font-family: Arial, sans-serif; background-color: #f4f6f9; color: #333; margin: 0; padding: 20px; }
    .card { background: #ffffff; border-radius: 8px; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); border-top: 4px solid #0066cc; }
    .card.P1 { border-top-color: #d9534f; }
    .card.P2 { border-top-color: #f0ad4e; }
    .card.P3 { border-top-color: #5bc0de; }
    .card.P4 { border-top-color: #5cb85c; }
    .status-firing { color: #d9534f; font-weight: bold; }
    .status-resolved { color: #5cb85c; font-weight: bold; }
    .meta-table { width: 100%; border-collapse: collapse; margin-top: 15px; }
    .meta-table td { padding: 8px; border-bottom: 1px solid #eee; }
    .meta-table td.label { font-weight: bold; width: 30%; color: #555; }
    .btn { display: inline-block; padding: 8px 16px; background-color: #0066cc; color: #ffffff; text-decoration: none; border-radius: 4px; font-weight: bold; margin-right: 10px; }
    .btn-runbook { background-color: #4b5563; }
  </style>
</head>
<body>
  <div class="card {{ .CommonLabels.severity }}">
    <h2>[SupplyForge] Notification Report</h2>
    <p>Status: <span class="status-{{ .Status }}">{{ .Status | toUpper }}</span></p>
    
    <table class="meta-table">
      <tr><td class="label">Alert Name:</td><td>{{ .CommonLabels.alertname }}</td></tr>
      <tr><td class="label">Severity:</td><td><strong>{{ .CommonLabels.severity }}</strong></td></tr>
      <tr><td class="label">Service:</td><td>{{ .CommonLabels.service }}</td></tr>
      <tr><td class="label">Environment:</td><td>{{ .CommonLabels.environment }}</td></tr>
      <tr><td class="label">Team:</td><td>{{ .CommonLabels.team }}</td></tr>
    </table>

    <h3>Alert Details:</h3>
    {{ range .Alerts }}
    <div style="background-color: #f8fafc; padding: 12px; border-left: 3px solid #0066cc; margin-bottom: 10px;">
      <p><strong>Summary:</strong> {{ .Annotations.summary }}</p>
      <p><strong>Description:</strong> {{ .Annotations.description }}</p>
      <p><small>Started At: {{ .StartsAt }}</small></p>
      {{ if .Annotations.runbook_url }}
        <a href="{{ .Annotations.runbook_url }}" class="btn btn-runbook" target="_blank">View Runbook</a>
      {{ end }}
      {{ if .Annotations.dashboard_url }}
        <a href="{{ .Annotations.dashboard_url }}" class="btn" target="_blank">View Dashboard</a>
      {{ end }}
    </div>
    {{ end }}

    <p style="margin-top: 20px; font-size: 12px; color: #888;">
      Generated automatically by SupplyForge Observability Plane (Alertmanager).
    </p>
  </div>
</body>
</html>
{{ end }}
