      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "rate(mysql_global_status_slow_queries[5m])",
          "legendFormat": "Slow Queries / sec",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Slow Query Rate",
      "type": "stat"
    },
