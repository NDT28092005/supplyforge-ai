<mxfile host="app.diagrams.net" modified="2026-10-29T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="p0-runtime" name="P0-P1 Runtime">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="SupplyForge - P0/P1 runtime (protected request path and worker isolation)" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#0F172A;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1080" height="40" as="geometry"/></mxCell>
        <mxCell id="note" value="Solid lines: implemented runtime responsibility. P1 adds bounded lists, composite read indexes, request correlation, compression and edge rate limits. Dashed lines: optional S3 multipart mode. No Terraform execution is required." style="text;html=1;fontSize=12;fontColor=#475569;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1320" height="30" as="geometry"/></mxCell>
        <mxCell id="client" value="Merchant browser&#xa;Angular SPA&#xa;Page-sized lists only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0C4A6E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="edge" value="Nginx edge&#xa;Per-IP request + connection limits&#xa;Static cache, gzip, streamed CSV upload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#334155;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="160" width="160" height="130" as="geometry"/></mxCell>
        <mxCell id="api" value="Django API / Gunicorn&#xa;Authentication + tenant boundary&#xa;X-Request-ID + JSON access events&#xa;Read-only dashboard APIs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="150" width="245" height="145" as="geometry"/></mxCell>
        <mxCell id="redis" value="Redis&#xa;Cache only on request path&#xa;Celery broker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="790" y="120" width="180" height="95" as="geometry"/></mxCell>
        <mxCell id="db" value="Relational database&#xa;Tenant data, jobs, risk results&#xa;Capital read model + P1 query indexes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7E22CE;fontColor=#581C87;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="790" y="270" width="210" height="100" as="geometry"/></mxCell>
        <mxCell id="worker" value="Dedicated Celery worker&#xa;CSV ingestion, feature/risk inference&#xa;Capital read-model generation&#xa;Gold aggregate + cache warming" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1090" y="170" width="255" height="130" as="geometry"/></mxCell>
        <mxCell id="storage" value="Object storage (optional cloud mode)&#xa;Immutable raw CSV&#xa;Bronze / Silver / Gold artifacts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#7C2D12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1090" y="390" width="255" height="100" as="geometry"/></mxCell>
        <mxCell id="jobstatus" value="Job status contract&#xa;Browser polls only while&#xa;there are active jobs and tab is visible" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="470" y="385" width="245" height="85" as="geometry"/></mxCell>
        <mxCell id="gold" value="Dashboard read model&#xa;Worker-published gold aggregate&#xa;Cache miss: gold/stale response, never SKU scan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFCCB;strokeColor=#65A30D;fontColor=#365314;" vertex="1" parent="1"><mxGeometry x="790" y="455" width="210" height="95" as="geometry"/></mxCell>
        <mxCell id="observability" value="Structured operations log&#xa;Request ID, route, status, duration&#xa;No request body or query string" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="470" y="570" width="245" height="85" as="geometry"/></mxCell>
        <mxCell id="e-client-edge" value="HTTPS REST" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#0284C7;" edge="1" parent="1" source="client" target="edge"><mxGeometry relative="1" as="geometry"/></mxCell>
